{
  "name": "casino-management-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "web",
    "web-admin",
    "helper"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "dev:all": "concurrently \"pnpm --filter api dev\" \"pnpm --filter web dev\" \"pnpm --filter web-admin dev\"",
    "build": "pnpm --filter '*' build",
    "test": "pnpm --filter '*' test",
    "test:watch": "pnpm --filter '*' test:watch",
    "lint": "pnpm --filter '*' lint",
    "format": "pnpm --filter '*' format",
    "type-check": "pnpm -r type-check",
    "api:dev": "pnpm --filter api dev",
    "web:dev": "pnpm --filter web dev",
    "web-admin:dev": "pnpm --filter web-admin dev",
    "web-admin:build": "pnpm --filter web-admin build",
    "helper:build": "pnpm --filter helper build",
    "run:api": "pnpm --filter api dev",
    "run:web": "pnpm --filter web dev",
    "install:api": "pnpm --filter api install",
    "install:web": "pnpm --filter web install",
    "install:web-admin": "pnpm --filter web-admin install",
    "install:helper": "pnpm --filter helper install",
    "install:all": "pnpm install",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "api/src/**/*.ts": [
      "eslint --fix"
    ],
    "web/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "web-admin/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "helper/src/**/*.ts": [
      "eslint --fix"
    ]
  }
}
