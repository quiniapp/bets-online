# WEB-ADMIN (backoffice) — copiar a web-admin/.env.local
# Destino del rewrite /api/* (next.config.mjs). Se lee en build.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Vercel Speed Insights. Solo "true" en Production de Vercel. Se lee en build.
ENABLE_SPEED_INSIGHTS=false
# Fracción de visitas medidas (0-1]. Default 0.01 si falta o es inválida.
SPEED_INSIGHTS_SAMPLE_RATE=0.01
