# API — copiar a api/.env.local (desarrollo) y completar.
# Lista completa, defaults y valores por entorno: docs/environment-variables.md

NODE_ENV=local
PORT=3001
API_URL=http://localhost:3001

# Postgres. Cualquier instancia local sirve; esta es la del Supabase local de api/supabase/config.toml
DATABASE_URL=postgresql://postgres:postgres@localhost:55322/postgres

# Secrets: mínimo 32 caracteres cada uno, distintos entre sí y por entorno.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-min-32-characters-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-min-32-characters-change-this
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=your-session-secret-min-32-characters-change-this

# CORS. Los frontends llaman same-origin vía rewrites; esto cubre llamadas directas a la API
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# Supabase Storage (uploads de banners, imágenes de juegos y logos). Opcional en local
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_KEY=

# 21Viral (obligatorias; VIRAL_SECRET_KEY mínimo 32 caracteres)
VIRAL_USERNAME=your-viral-username
VIRAL_SECRET_KEY=your-viral-secret-key-min-32-characters-change-this
INTEGRATOR_URL=https://api.stg.games-viral.com/

# Opcionales
# LOG_LEVEL=debug                    # pino; default info en production, debug fuera
APP_TIMEZONE=America/Argentina/Buenos_Aires
